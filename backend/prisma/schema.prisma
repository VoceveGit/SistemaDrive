// backend/prisma/schema.prisma — Schema do banco interno da aplicação (Neon PostgreSQL)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AppSettings {
  id                Int      @id @default(1)
  dbType            String   @default("postgresql")
  dbHost            String   @default("")
  dbPort            Int      @default(5432)
  dbName            String   @default("")
  dbUser            String   @default("")
  dbPassword        String   @default("")
  googleCredentials String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Company {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  color            String   @default("#4F8EF7")
  googleFolderId   String
  targetTable      String?
  dateColumn       String?
  /** Coluna principal (ex.: Pedido, numero) — usada em comparação/UPDATE */
  compareColumn    String?
  primaryKeyColumn String?
  columnMapping    Json?
  active           Boolean  @default(true)
  /** Se true, planilhas novas/atualizadas são enviadas ao banco automaticamente */
  autoSend         Boolean  @default(false)

  /** Linha do cabeçalho (1-based). Default 1 = comportamento legado */
  headerRow        Int      @default(1)
  /** Linha inicial dos dados (1-based). Null = headerRow + 1 */
  dataRow          Int?
  /** Nome da aba; null = primeira aba */
  sheetName        String?
  autofillEmpty    Boolean  @default(false)
  skipEmptyRows    Boolean  @default(true)
  /** { column: string, values: string[] } — ignorar linhas cujo valor na coluna está na lista */
  ignoreRules      Json?

  /** exact_name | new_files | latest_only */
  fileMode         String   @default("latest_only")
  exactFileName    String?

  /**
   * incremental | incremental_update | principal_only | snapshot
   * - incremental: só INSERT do que não existe (legado)
   * - incremental_update: INSERT + UPDATE (cascata pela coluna principal)
   * - principal_only: INSERT se valor da coluna principal não existe no banco
   * - snapshot: limpa tabela e insere tudo
   */
  syncMode         String   @default("incremental")
  /** Se true e dateColumn setada: filtra banco pelo mês da 1ª linha de dados */
  useDateFilter    Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  spreadsheets     Spreadsheet[]
}

model Spreadsheet {
  id                    String    @id @default(cuid())
  companyId             String
  company               Company   @relation(fields: [companyId], references: [id])
  googleFileId          String
  googleModifiedTime    DateTime?
  fileName              String
  totalRows             Int       @default(0)
  processedRows         Int       @default(0)
  newRows               Int       @default(0)
  updatedRows           Int       @default(0)
  status                String    @default("pending")
  /** Mensagem curta de progresso/erro do job em partes */
  processMessage        String?
  sentAt                DateTime?
  detectedAt            DateTime  @default(now())
  rawData               String
  previousSpreadsheetId String?
  approvedBy            String?
  sentBy                String?

  @@index([companyId, detectedAt])
  @@index([googleFileId])
}
